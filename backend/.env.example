# ════════════════════════════════════════════════════════════════════
#  IntelligentAppCalls Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env to git.
# ════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────
# Local MySQL (current, works out of the box):
DATABASE_URL=mysql+pymysql://root:@localhost:3306/appcall_db

# PostgreSQL (target — use with docker-compose):
# DATABASE_URL=postgresql://appcall:appcall_password@localhost:5432/appcall_db

# SQLite (for quick local tests, no Docker needed):
# DATABASE_URL=sqlite:///./appcall.db

# ─── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_secret_key_in_production

# ─── AI — OpenAI ──────────────────────────────────────────────────────
# Required for: GPT-4o-mini summarization + text-embedding-3-small chatbot
# Leave empty to use offline fallback (no AI summaries, no chatbot embeddings)
OPENAI_API_KEY=

# GPT model for summarization and chatbot
OPENAI_MODEL=gpt-4o-mini

# ─── AI — Whisper (local, free) ───────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3
# Recommendation: "small" for good speed/accuracy on CPU
WHISPER_MODEL=small

# Device: "cpu" or "cuda" (if you have an NVIDIA GPU)
WHISPER_DEVICE=cpu

# Compute type: "int8" (CPU), "float16" (GPU), "float32" (fallback)
WHISPER_COMPUTE=int8

# Transcript language (force French)
WHISPER_LANGUAGE=fr

# ─── AI — Speaker Diarization (optional) ─────────────────────────────
# Set to "true" to enable speaker detection (who is talking)
# Requires a free HuggingFace account + accept model terms at:
# https://huggingface.co/pyannote/speaker-diarization-3.1
USE_DIARIZATION=false
HF_TOKEN=

# ─── AI — Groq (Ultra-Fast Llama-3.3 RDV Extraction & Summarization) ─
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── AI — Deepgram (Real-Time French Speech-to-Text) ─────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ─── Cloud Telephony & Multi-VoIP Providers ──────────────────────────
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# Telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=

# Plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=

# ─── Object Storage — MinIO (local) ───────────────────────────────────
# "local" = save files in ./uploads directory (no Docker needed)
# "minio" = use MinIO object store (requires docker-compose)
STORAGE_MODE=local

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=appcall-audio
MINIO_SECURE=false

# Local upload directory (used when STORAGE_MODE=local)
UPLOAD_DIR=./uploads

# ─── Celery / Redis ───────────────────────────────────────────────────
# Background task queue (optional — falls back to threading if not running)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BACKEND_URL=redis://localhost:6379/1

# ─── Chatbot ──────────────────────────────────────────────────────────
# Number of past messages to keep in context per session
CHATBOT_MAX_HIST=10

# Characters per transcript chunk (for embedding/RAG)
EMBEDDING_CHUNK_SIZE=400
